# Set line endings to LF for all text files
* text=auto

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Config files
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
